<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 840" width="1200" height="840">
<style>
.t{font: 600 22px Arial, sans-serif; fill:#17324d}
.s{font: 600 16px Arial, sans-serif; fill:#1d3b54}
.n{font: 700 14px Arial, sans-serif; fill:#4f46e5}
.box{fill:#ffffff; stroke:#94a3b8; stroke-width:1.5; rx:10}
.sec1{fill:#dbeafe; stroke:#60a5fa; stroke-width:2; rx:12}
.sec2{fill:#dcfce7; stroke:#4ade80; stroke-width:2; rx:12}
.sec3{fill:#f3e8ff; stroke:#c084fc; stroke-width:2; rx:12}
.line{stroke:#475569; stroke-width:2; fill:none}
.label{font: 700 17px Arial, sans-serif;}
</style>
<rect x="330" y="18" width="540" height="68" rx="14" fill="#163d6d"/>
<text x="600" y="48" text-anchor="middle" fill="white" class="t">LA EMPRESA Y SU ORGANIZACIÓN</text>
<text x="600" y="73" text-anchor="middle" fill="white" class="t">EL PROCESO DE COMUNICACIÓN</text>

<path class="line" d="M600 86 V110 M190 110 H1010"/>
<path class="line" d="M190 110 V140 M600 110 V140 M1010 110 V140"/>

